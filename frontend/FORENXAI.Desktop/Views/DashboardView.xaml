<UserControl x:Class="FORENXAI.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">

    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Margin="10,0,24,0" VerticalAlignment="Center" TextElement.Foreground="#E2E8F0"/>
                                                <TextBlock Text="&#x25BE;" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" StaysOpen="False"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#E2E8F0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <!-- Dark cells for both tables: selected row in blue (set on the cells,
             since DataGrid's row backgrounds override a row-style trigger),
             no focus box, text centred in the row. -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="FORENSIC DASHBOARD"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Network forensic analysis overview"
                           Foreground="#94A3B8"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Status:"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock x:Name="StatusText"
                           Text="No case loaded"
                           Foreground="#60A5FA"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>

        <!-- CASE LOADER -->
        <Border Grid.Row="1"
                Background="#151F2F"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Case ID"
                           Foreground="#CBD5E1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBox x:Name="CaseIdTextBox"
                         Grid.Column="1"
                         Height="36"
                         Padding="10,7"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#334155"
                         BorderThickness="1"/>

                <Button Grid.Column="2"
                        Content="LOAD CASE"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Click="LoadCase_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

                <StackPanel Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FILE METADATA" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="CopyMetadataButton" Content="⧉" Click="CopyMetadata_Click" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="12" Foreground="#CBD5E1" Background="#1E293B" BorderBrush="#334155" ToolTip="Copy file metadata"/>
                    </StackPanel>
                    <TextBlock x:Name="FileMetadataText" Text="No file metadata loaded" Width="650" Foreground="#CBD5E1" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="2"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ML FLOWS"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalFlowsText"
                               Text="0"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="Flows analyzed by XGBoost"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="BENIGN"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="BenignFlowsText"
                               Text="0"
                               Foreground="#4ADE80"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="Flows classified as benign"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0">
                <StackPanel>
                    <TextBlock Text="THREATS"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThreatFlowsText"
                               Text="0"
                               Foreground="#F87171"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="Potential malicious flows"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="THREAT PERCENTAGE"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ThreatPercentageText"
                               Text="0.00%"
                               Foreground="#FBBF24"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>
                    <TextBlock Text="Share of analyzed ML flows"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- ===================================================== -->
        <!-- RULE-BASED DETECTION (Tier 1 + Tier 2 + hybrid verdict) -->
        <!-- ===================================================== -->

        <Border Grid.Row="3"
                Background="#151F2F"
                CornerRadius="10"
                Padding="16,14"
                Margin="0,0,0,18">

            <Border.Resources>
                <ControlTemplate x:Key="RuleBarTemplate" TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1E293B" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Border.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RULE-BASED DETECTION" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Flows flagged by each rule class. Tier 1 reads the flow records; Tier 2 reads the packets (scapy checks and Suricata). The line shows what backs each flow's class: a rule, the model alone, or uncertain."
                                   Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="RulesVersionText" Text="" Foreground="#64748B" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TIER 1 -->
                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TIER 1 · FLOW RULES" Foreground="#FDE68A" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="Tier1SummaryText" Text="--" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,8"/>
                            <ScrollViewer Padding="0,0,12,0" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="Tier1Bars">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6" ToolTip="{Binding Tooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Height="14" Minimum="0"
                                         Maximum="{Binding Max}" Value="{Binding Count}"
                                         Foreground="{Binding Brush}" Template="{StaticResource RuleBarTemplate}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- TIER 2 -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TIER 2 · PACKET RULES" Foreground="#A5B4FC" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="Tier2SummaryText" Text="--" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,8"/>
                            <ScrollViewer Padding="0,0,12,0" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="Tier2Bars">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6" ToolTip="{Binding Tooltip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Grid.Column="1" Height="14" Minimum="0"
                                         Maximum="{Binding Max}" Value="{Binding Count}"
                                         Foreground="{Binding Brush}" Template="{StaticResource RuleBarTemplate}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="Tier2StatusText" Text="" Foreground="#64748B" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- HYBRID SOURCE: who backs each flow's class, as one stacked line -->
                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="HYBRID SOURCE" Foreground="#BBF7D0" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="VerdictSummaryText" Text="--" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,8"/>
                            <Border CornerRadius="4" ClipToBounds="True" Height="14" Background="#1E293B">
                                <Grid x:Name="VerdictBar"/>
                            </Border>
                            <ItemsControl x:Name="VerdictLegend" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4" ToolTip="{Binding Tooltip}">
                                            <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}"
                                                    VerticalAlignment="Top" Margin="0,3,6,0"/>
                                            <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TIER 2 EVIDENCE: full width and collapsed by default so the
                     three cards above keep equal height -->
                <StackPanel Grid.Row="2" x:Name="Tier2DetailsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <ToggleButton x:Name="Tier2DetailsToggle" HorizontalAlignment="Left" Cursor="Hand"
                                  Checked="Tier2DetailsToggle_Changed" Unchecked="Tier2DetailsToggle_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="#0F172A" CornerRadius="6" Padding="10,5">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock x:Name="Tier2DetailsHeader" Foreground="#A5B4FC" FontSize="12" FontWeight="SemiBold"/>
                    </ToggleButton>
                    <Border x:Name="Tier2DetailsBody" Background="#0F172A" CornerRadius="8" Padding="12"
                            Margin="0,8,0,0" Visibility="Collapsed">
                        <ScrollViewer Padding="0,0,12,0" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="Tier2DetailsText" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>


        <!-- MAIN DASHBOARD -->
        <!-- Top: ML attack types beside rule-based attack types (equal halves).
             Below: detected threats and all packets at full width. -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TRAFFIC CLASSIFICATION -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,12">

                        <TextBlock Text="TRAFFIC CLASSIFICATION"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TrafficChartSubtitleText"
                                   Text="Attack types predicted by the ML model (benign flows are not charted)"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DONUT -->
                        <Grid Grid.Column="0"
                              Width="230"
                              Height="230"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                            <Canvas x:Name="TrafficChartCanvas"
                                    Width="220"
                                    Height="220"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">

                                <TextBlock x:Name="TrafficChartTotalText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="ML attack flows"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>

                            </StackPanel>

                        </Grid>

                        <!-- LEGEND -->
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="230"
                                      Margin="12,0,0,0">

                            <ItemsControl x:Name="TrafficLegendItemsControl">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{Binding Brush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,9,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ClassName}"
                                                       Foreground="#E2E8F0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayValue}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Grid>

            </Border>

            <!-- RULE-BASED DETECTED ATTACKS: attack types the rule evidence supports -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="RULE-BASED DETECTED ATTACKS" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="AttackEvidenceSubtitleText"
                                   Text="Attack types supported by the rule evidence"
                                   Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="EvidencePieCanvas" Width="220" Height="220"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock x:Name="EvidencePieTotalText" Text="0" Foreground="White" FontSize="24"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rule-backed flows" Foreground="#94A3B8" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ItemsControl x:Name="AttackEvidenceLegend">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10" ToolTip="{Binding Tooltip}">
                                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Brush}"
                                                     VerticalAlignment="Top" Margin="0,4,10,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountDisplay}" Foreground="White"
                                                       FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="#E2E8F0" FontSize="13"/>
                                                <TextBlock Text="{Binding Tooltip}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EvidenceNoteText" Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- DETECTED THREATS -->
            <Border Grid.Row="1" Grid.ColumnSpan="3"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filters: protocol, ML prediction, free text -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <ComboBox x:Name="ThreatProtocolFilter" Width="130" SelectionChanged="ThreatFilter_Changed"/>
                        <ComboBox x:Name="ThreatClassFilter" Width="170" Margin="8,0,0,0" SelectionChanged="ThreatFilter_Changed"/>
                        <TextBox x:Name="ThreatSearchBox" Width="300" Margin="8,0,0,0" Style="{StaticResource FilterBox}"
                                 ToolTip="IP address, port, class or info text" TextChanged="ThreatFilter_Changed"/>
                        <TextBlock x:Name="ThreatFilterStatusText" Foreground="#94A3B8" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="DETECTED THREATS"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="ThreatCountText"
                                       Text="0 threat flows"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                            <TextBlock Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="ML Prediction and ML Confidence: the XGBoost model's class and its probability. Supporting Evidence: the attack class the rule evidence supports and its source. Length is the bytes of the connection; Info lists its ports, TCP flags and packets. Double-click a row to open it in XAI."/>

                        </StackPanel>

                    </Grid>

                    <DataGrid x:Name="ThreatDataGrid"
                              MouseDoubleClick="ThreatDataGrid_MouseDoubleClick"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="#0F172A"
                              Foreground="White"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              VerticalGridLinesBrush="#1E293B"
                              RowBackground="#0F172A"
                              AlternatingRowBackground="#111C2E"
                              HeadersVisibility="Column"
                              RowHeight="30"
                              ColumnHeaderHeight="34"
                              MaxHeight="484"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="BorderBrush" Value="#1E293B"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Flow" Binding="{Binding FlowIndex}" Width="55"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.55*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.3*"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.6*"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="0.6*"/>
                            <DataGridTextColumn Header="ML Prediction" Binding="{Binding PredictedClass}" Width="0.85*"/>
                            <DataGridTextColumn Header="ML Confidence" Binding="{Binding ConfidenceDisplay}" Width="0.95*"/>
                            <DataGridTextColumn Header="Supporting Evidence" Binding="{Binding VerdictDisplay}" Width="1.4*"/>
                            <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="1.6*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- PACKETS: every packet in the capture, filterable -->
            <Border Grid.Row="2" Grid.ColumnSpan="3"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="PACKETS" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="PacketCountText" Text="0 packets" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <ComboBox x:Name="PacketProtocolFilter" Width="130" SelectionChanged="PacketFilter_Changed"/>
                        <ComboBox x:Name="PacketFlagFilter" Width="130" Margin="8,0,0,0" SelectionChanged="PacketFilter_Changed"/>
                        <TextBox x:Name="PacketSearchBox" Width="300" Margin="8,0,0,0" Style="{StaticResource FilterBox}"
                                 ToolTip="IP address, MAC address, port or info text" TextChanged="PacketFilter_Changed"/>
                        <TextBlock x:Name="PacketFilterStatusText" Foreground="#94A3B8" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <DataGrid x:Name="PacketDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Background="#0F172A"
                              Foreground="White"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              RowBackground="#0F172A"
                              AlternatingRowBackground="#111C2E"
                              HeadersVisibility="Column"
                              RowHeight="28"
                              ColumnHeaderHeight="34"
                              Height="520"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No." Binding="{Binding Number}" Width="70"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.3*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.3*"/>
                            <DataGridTextColumn Header="Src Port" Binding="{Binding SourcePort}" Width="0.6*"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*"/>
                            <DataGridTextColumn Header="Dst Port" Binding="{Binding DestinationPort}" Width="0.6*"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="0.6*"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="0.6*"/>
                            <DataGridTextColumn Header="TCP Flags" Binding="{Binding Flags}" Width="0.7*"/>
                            <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="1.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>

        </Grid>

    </ScrollViewer>

</UserControl>
