<UserControl x:Class="FORENXAI.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0">

                <TextBlock Text="FORENSIC DASHBOARD"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Network forensic analysis overview"
                           Foreground="#94A3B8"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Status:"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock x:Name="StatusText"
                           Text="No case loaded"
                           Foreground="#60A5FA"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- CASE LOADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="#151F2F"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Case ID"
                           Foreground="#CBD5E1"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>


                <TextBox x:Name="CaseIdTextBox"
                         Grid.Column="1"
                         Height="36"
                         Padding="10,7"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#334155"
                         BorderThickness="1"/>


                <Button Grid.Column="2"
                        Content="LOAD CASE"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Click="LoadCase_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>


                <TextBlock Grid.Column="3"
                           Text="Load an existing analyzed FORENXAI case."
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- SUMMARY CARDS -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- TOTAL FLOWS -->

            <Border Grid.Column="0"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="TOTAL ML FLOWS"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="TotalFlowsText"
                               Text="0"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>

                    <TextBlock Text="Flows analyzed by XGBoost"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- BENIGN -->

            <Border Grid.Column="1"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>

                    <TextBlock Text="BENIGN"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="BenignFlowsText"
                               Text="0"
                               Foreground="#4ADE80"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>

                    <TextBlock Text="Flows classified as benign"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- THREATS -->

            <Border Grid.Column="2"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>

                    <TextBlock Text="THREATS"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ThreatFlowsText"
                               Text="0"
                               Foreground="#F87171"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>

                    <TextBlock Text="Potential malicious flows"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <!-- THREAT PERCENTAGE -->

            <Border Grid.Column="3"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="8,0,0,0">

                <StackPanel>

                    <TextBlock Text="THREAT PERCENTAGE"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ThreatPercentageText"
                               Text="0.00%"
                               Foreground="#FBBF24"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,7,0,0"/>

                    <TextBlock Text="Share of analyzed ML flows"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- MAIN DASHBOARD -->
        <!-- ===================================================== -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT SIDE: THREAT TABLE -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock Text="DETECTED THREATS"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="ThreatCountText"
                                       Text="0 threat flows"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>


                    <DataGrid x:Name="ThreatDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="ThreatDataGrid_SelectionChanged"
                              Background="#0F172A"
                              Foreground="White"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              VerticalGridLinesBrush="#1E293B"
                              RowBackground="#0F172A"
                              AlternatingRowBackground="#111C2E"
                              HeadersVisibility="Column">

                        <DataGrid.ColumnHeaderStyle>

                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                                        Value="#1E293B"/>

                                <Setter Property="Foreground"
                                        Value="#CBD5E1"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Setter Property="Padding"
                                        Value="10"/>

                                <Setter Property="BorderBrush"
                                        Value="#334155"/>

                                <Setter Property="BorderThickness"
                                        Value="0,0,1,1"/>

                            </Style>

                        </DataGrid.ColumnHeaderStyle>


                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow">

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter Property="Background"
                                        Value="#0F172A"/>

                                <Setter Property="BorderBrush"
                                        Value="#1E293B"/>

                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>

                                <Style.Triggers>

                                    <Trigger Property="IsSelected"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#1D4ED8"/>

                                        <Setter Property="Foreground"
                                                Value="White"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </DataGrid.RowStyle>


                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Flow"
                                                Binding="{Binding FlowIndex}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Source"
                                                Binding="{Binding Source}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Destination"
                                                Binding="{Binding Destination}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Class"
                                                Binding="{Binding PredictedClass}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Confidence"
                                                Binding="{Binding ConfidenceDisplay}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- RIGHT SIDE -->
            <!-- ================================================= -->

            <Grid Grid.Column="1"
                  Margin="10,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ============================================= -->
                <!-- SELECTED THREAT -->
                <!-- ============================================= -->

                <Border Grid.Row="0"
                        Background="#151F2F"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER + OPEN XAI -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="SELECTED THREAT"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="SelectedThreatClassText"
                                           Text="Select a threat flow"
                                           Foreground="#F87171"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"/>

                            </StackPanel>


                            <!-- ================================= -->
                            <!-- PHASE 15.2: OPEN XAI BUTTON -->
                            <!-- ================================= -->

                            <Button x:Name="OpenXaiButton"
                                    Grid.Column="1"
                                    Content="OPEN XAI"
                                    Width="125"
                                    Height="38"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="OpenXai_Click"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    ToolTip="Open the selected threat in the XAI investigation view"/>

                        </Grid>


                        <!-- SELECTED THREAT DETAILS -->

                        <Grid Grid.Row="1"
                              Margin="0,18,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- FLOW -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Flow Index"
                                           Foreground="#64748B"
                                           FontSize="11"/>

                                <TextBlock x:Name="SelectedFlowIndexText"
                                           Text="--"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <!-- CONFIDENCE -->

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Confidence"
                                           Foreground="#64748B"
                                           FontSize="11"/>

                                <TextBlock x:Name="SelectedConfidenceText"
                                           Text="--"
                                           Foreground="#60A5FA"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <!-- DIRECTION SUMMARY -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Explanation"
                                           Foreground="#64748B"
                                           FontSize="11"/>

                                <TextBlock x:Name="SelectedExplanationText"
                                           Text="Select a row below"
                                           Foreground="#CBD5E1"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ============================================= -->
                <!-- SHAP CONTRIBUTORS -->
                <!-- ============================================= -->

                <Border Grid.Row="1"
                        Background="#151F2F"
                        CornerRadius="10"
                        Padding="16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,12">

                            <TextBlock Text="TOP SHAP CONTRIBUTORS"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Features with the greatest influence on the selected prediction"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <DataGrid x:Name="ShapDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  VerticalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column">

                            <DataGrid.ColumnHeaderStyle>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#1E293B"/>

                                    <Setter Property="Foreground"
                                            Value="#CBD5E1"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                    <Setter Property="Padding"
                                            Value="10"/>

                                    <Setter Property="BorderBrush"
                                            Value="#334155"/>

                                    <Setter Property="BorderThickness"
                                            Value="0,0,1,1"/>

                                </Style>

                            </DataGrid.ColumnHeaderStyle>


                            <DataGrid.RowStyle>

                                <Style TargetType="DataGridRow">

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                    <Setter Property="Background"
                                            Value="#0F172A"/>

                                    <Setter Property="BorderBrush"
                                            Value="#1E293B"/>

                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>

                                </Style>

                            </DataGrid.RowStyle>


                            <DataGrid.Columns>

                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Rank}"
                                                    Width="45"/>

                                <DataGridTextColumn Header="Feature"
                                                    Binding="{Binding Feature}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Observed Value"
                                                    Binding="{Binding RawValue}"
                                                    Width="125"/>

                                <DataGridTextColumn Header="SHAP Value"
                                                    Binding="{Binding ShapValue}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Direction"
                                                    Binding="{Binding DirectionDisplay}"
                                                    Width="155"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>