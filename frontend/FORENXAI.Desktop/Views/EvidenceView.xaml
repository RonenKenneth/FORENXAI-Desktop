<UserControl x:Class="FORENXAI.Desktop.Views.EvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0F172A">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#111827"
                Padding="30,22">

            <StackPanel>

                <TextBlock
                    Text="EVIDENCE"
                    Foreground="#F8FAFC"
                    FontSize="28"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Network Evidence Acquisition"
                    Foreground="#94A3B8"
                    FontSize="14"
                    Margin="0,5,0,0"/>

            </StackPanel>

        </Border>


        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- UPLOAD AREA -->
                <Border Grid.Row="0"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="35"
                        Margin="0,0,0,20">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="NETWORK EVIDENCE"
                            Foreground="#60A5FA"
                            FontSize="13"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Select a PCAP file for forensic analysis"
                            Foreground="#F8FAFC"
                            FontSize="20"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,5"/>

                        <TextBlock
                            Text="Supported formats: .pcap and .pcapng"
                            Foreground="#94A3B8"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"/>

                        <Button
                            Content="BROWSE PCAP FILE"
                            Width="220"
                            Height="45"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="BrowsePcap_Click"/>

                    </StackPanel>

                </Border>


                <!-- EVIDENCE INFORMATION -->
                <Border Grid.Row="1"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock
                            Text="EVIDENCE INFORMATION"
                            Foreground="#F8FAFC"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Case ID"
                                Foreground="#94A3B8"
                                Margin="0,8"/>

                            <TextBlock
                                x:Name="CaseIdText"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="Not created"
                                Foreground="#F8FAFC"
                                FontWeight="SemiBold"
                                Margin="0,8"/>


                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="File Name"
                                Foreground="#94A3B8"
                                Margin="0,8"/>

                            <TextBlock
                                x:Name="FileNameText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="No evidence selected"
                                Foreground="#F8FAFC"
                                Margin="0,8"
                                TextWrapping="Wrap"/>


                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="File Size"
                                Foreground="#94A3B8"
                                Margin="0,8"/>

                            <TextBlock
                                x:Name="FileSizeText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="--"
                                Foreground="#F8FAFC"
                                Margin="0,8"/>


                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="SHA-256"
                                Foreground="#94A3B8"
                                Margin="0,8"/>

                            <TextBlock
                                x:Name="HashText"
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="Not calculated"
                                Foreground="#60A5FA"
                                FontFamily="Consolas"
                                FontSize="12"
                                Margin="0,8"
                                TextWrapping="Wrap"/>


                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="Status"
                                Foreground="#94A3B8"
                                Margin="0,8"/>

                            <TextBlock
                                x:Name="StatusText"
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="Waiting for evidence"
                                Foreground="#FBBF24"
                                Margin="0,8"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- CASE LOCATION -->
                <Border Grid.Row="2"
                        Background="#172033"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock
                            Text="FORENSIC CASE"
                            Foreground="#F8FAFC"
                            FontSize="16"
                            FontWeight="Bold"
                            Margin="0,0,0,10"/>

                        <TextBlock
                            x:Name="CaseLocationText"
                            Text="Evidence has not been acquired yet."
                            Foreground="#94A3B8"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>


                <!-- START ANALYSIS -->
                <Button
                    x:Name="StartAnalysisButton"
                    Grid.Row="3"
                    Content="START FORENSIC ANALYSIS"
                    Height="55"
                    Background="#16A34A"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="Bold"
                    IsEnabled="False"
                    Click="StartAnalysis_Click"/>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>