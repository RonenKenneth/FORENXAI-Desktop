<UserControl x:Class="FORENXAI.Desktop.Views.InvestigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F172A">

    <UserControl.Resources>

        <Style x:Key="FilterLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#94A3B8"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>


        <Style x:Key="FilterComboItemStyle"
            TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="Background"
                    Value="#172033"/>

            <Setter Property="Padding"
                    Value="10,7"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                    Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1E3A8A"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                    Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="FilterComboStyle"
            TargetType="ComboBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="MinWidth"
                    Value="150"/>

            <Setter Property="Foreground"
                    Value="#F8FAFC"/>

            <Setter Property="Background"
                    Value="#172033"/>

            <Setter Property="BorderBrush"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource FilterComboItemStyle}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- CLOSED DROPDOWN BOX -->

                            <Border x:Name="MainBorder"
                                    Background="#172033"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="4">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="32"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- SELECTED VALUE -->

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="10,0,4,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        TextElement.Foreground="#F8FAFC"/>


                                    <!-- DROPDOWN ARROW -->

                                    <Border Grid.Column="1"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1,0,0,0">

                                        <Path Width="8"
                                            Height="5"
                                            Fill="#CBD5E1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 0 0 L 4 4 L 8 0 Z"/>

                                    </Border>

                                </Grid>

                            </Border>


                            <!-- CLICK AREA -->

                            <ToggleButton
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border Background="Transparent"/>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>


                            <!-- OPEN DROPDOWN -->

                            <Popup x:Name="PART_Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade">

                                <Border Background="#111827"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,2,0,0">

                                    <ScrollViewer
                                        MaxHeight="300"
                                        VerticalScrollBarVisibility="Auto">

                                        <StackPanel
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                    Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#3B82F6"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                    Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                    Value="False">

                                <Setter TargetName="MainBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#334155"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#2563EB"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Investigation Workspace"
                           Foreground="#F8FAFC"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock x:Name="CaseText"
                           Text="Case: --"
                           Foreground="#94A3B8"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button x:Name="ReviewSelectedButton"
                    Grid.Column="1"
                    Content="Review Selected Flow"
                    Click="ReviewSelectedButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    IsEnabled="False"/>

        </Grid>


        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,20,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="Loading investigation..."
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <TextBlock x:Name="VisibleCountText"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>

                    <TextBlock x:Name="ThreatCountText"
                               Foreground="#FCA5A5"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>

                    <TextBlock x:Name="ReviewCountText"
                               Foreground="#93C5FD"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Grid>

        </Border>


        <Border Grid.Row="3"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="SEARCH"
                               Style="{StaticResource FilterLabelStyle}"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="34"
                             Style="{StaticResource InputTextBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Search flow number, class, source, or destination"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="REVIEW STATUS"
                               Style="{StaticResource FilterLabelStyle}"/>

                    <ComboBox x:Name="ReviewFilterComboBox"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="FilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Reviews"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="Unreviewed"/>
                        <ComboBoxItem Content="Confirmed"/>
                        <ComboBoxItem Content="Rejected"/>
                        <ComboBoxItem Content="Inconclusive"/>
                    </ComboBox>

                </StackPanel>


                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">

                    <TextBlock Text="ML PREDICTION"
                               Style="{StaticResource FilterLabelStyle}"/>

                    <ComboBox x:Name="ClassFilterComboBox"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>

                </StackPanel>


                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">

                    <TextBlock Text="PRIORITY"
                               Style="{StaticResource FilterLabelStyle}"/>

                    <ComboBox x:Name="PriorityFilterComboBox"
                              Style="{StaticResource FilterComboStyle}"
                              SelectionChanged="FilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Priorities"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Uncertain"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Low"/>
                    </ComboBox>

                </StackPanel>


                <StackPanel Grid.Column="4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Bottom">

                    <Button Content="Next Unreviewed"
                            Click="NextUnreviewedButton_Click"
                            Height="34"
                            Padding="14,0"
                            Background="#1E3A8A"
                            Foreground="White"
                            BorderBrush="#1D4ED8"
                            BorderThickness="1"
                            FontWeight="SemiBold"/>

                </StackPanel>


                <StackPanel Grid.Column="5"
                            VerticalAlignment="Bottom">

                    <Button Content="Clear Filters"
                            Click="ClearFiltersButton_Click"
                            Height="34"
                            Padding="14,0"
                            Background="#1E293B"
                            Foreground="#E2E8F0"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            FontWeight="SemiBold"/>

                </StackPanel>

            </Grid>

        </Border>


        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,16,0">
                        <TextBlock Text="TO REVIEW"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryTotalText"
                                   Text="0"
                                   Foreground="#F8FAFC"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,16,0">
                        <TextBlock Text="UNREVIEWED"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryUnreviewedText"
                                   Text="0"
                                   Foreground="#CBD5E1"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,16,0">
                        <TextBlock Text="CONFIRMED"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryConfirmedText"
                                   Text="0"
                                   Foreground="#86EFAC"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Margin="0,0,16,0">
                        <TextBlock Text="REJECTED"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryRejectedText"
                                   Text="0"
                                   Foreground="#FCA5A5"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="INCONCLUSIVE"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SummaryInconclusiveText"
                                   Text="0"
                                   Foreground="#FDE68A"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                </Grid>


                <Grid Grid.Row="1"
                      Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ReviewProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#1E293B"
                                 Foreground="#2563EB"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"/>

                    <TextBlock x:Name="ReviewProgressText"
                               Grid.Column="1"
                               Text="0% reviewed"
                               Foreground="#93C5FD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>

                </Grid>

            </Grid>

        </Border>


        <Border Grid.Row="4"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1">

            <DataGrid x:Name="InvestigationGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="#111827"
                      Foreground="#E2E8F0"
                      BorderThickness="0"
                      RowBackground="#111827"
                      AlternatingRowBackground="#0F172A"
                      AlternationCount="2"
                      HorizontalGridLinesBrush="#1E293B"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectionChanged="InvestigationGrid_SelectionChanged"
                      MouseDoubleClick="InvestigationGrid_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0B1220"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="#1E293B"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="40"/>
                        <Setter Property="Foreground" Value="#E2E8F0"/>
                        <Setter Property="BorderBrush" Value="#1E293B"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#172033"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Flow"
                                        Binding="{Binding FlowIndex}"
                                        SortMemberPath="FlowIndex"
                                        Width="80"/>

                    <DataGridTextColumn Header="ML Prediction"
                                        Binding="{Binding PredictedClass}"
                                        SortMemberPath="PredictedClass"
                                        Width="150"/>

                    <DataGridTextColumn Header="Verdict (evidence)"
                                        Binding="{Binding EvidenceDisplay}"
                                        SortMemberPath="EvidenceDisplay"
                                        Width="230"/>

                    <DataGridTemplateColumn Header="Priority"
                                            SortMemberPath="PriorityRank"
                                            Width="105">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border x:Name="PriorityBadge"
                                        Background="#334155"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="PriorityBadgeText"
                                               Text="{Binding Priority}"
                                               Foreground="#CBD5E1"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>

                                </Border>

                                <DataTemplate.Triggers>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="High">
                                        <Setter TargetName="PriorityBadge"
                                                Property="Background"
                                                Value="#7F1D1D"/>
                                        <Setter TargetName="PriorityBadgeText"
                                                Property="Foreground"
                                                Value="#FECACA"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="Medium">
                                        <Setter TargetName="PriorityBadge"
                                                Property="Background"
                                                Value="#78350F"/>
                                        <Setter TargetName="PriorityBadgeText"
                                                Property="Foreground"
                                                Value="#FDE68A"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="Uncertain">
                                        <Setter TargetName="PriorityBadge"
                                                Property="Background"
                                                Value="#334155"/>
                                        <Setter TargetName="PriorityBadgeText"
                                                Property="Foreground"
                                                Value="#E2E8F0"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="Low">
                                        <Setter TargetName="PriorityBadge"
                                                Property="Background"
                                                Value="#14532D"/>
                                        <Setter TargetName="PriorityBadgeText"
                                                Property="Foreground"
                                                Value="#BBF7D0"/>
                                    </DataTrigger>

                                </DataTemplate.Triggers>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ML Confidence"
                                        Binding="{Binding ConfidenceDisplay}"
                                        SortMemberPath="Confidence"
                                        Width="110"/>

                    <DataGridTextColumn Header="Source"
                                        Binding="{Binding SourceDisplay}"
                                        SortMemberPath="SourceDisplay"
                                        Width="170"/>

                    <DataGridTextColumn Header="Destination"
                                        Binding="{Binding DestinationDisplay}"
                                        SortMemberPath="DestinationDisplay"
                                        Width="170"/>

                    <DataGridTemplateColumn Header="Review"
                                            SortMemberPath="ReviewDecision"
                                            Width="130">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border x:Name="ReviewBadge"
                                        Background="#334155"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                    <TextBlock x:Name="ReviewBadgeText"
                                               Text="{Binding ReviewDecision}"
                                               Foreground="#CBD5E1"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>

                                </Border>

                                <DataTemplate.Triggers>

                                    <DataTrigger Binding="{Binding ReviewDecision}"
                                                 Value="Confirmed">
                                        <Setter TargetName="ReviewBadge"
                                                Property="Background"
                                                Value="#14532D"/>
                                        <Setter TargetName="ReviewBadgeText"
                                                Property="Foreground"
                                                Value="#BBF7D0"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ReviewDecision}"
                                                 Value="Rejected">
                                        <Setter TargetName="ReviewBadge"
                                                Property="Background"
                                                Value="#7F1D1D"/>
                                        <Setter TargetName="ReviewBadgeText"
                                                Property="Foreground"
                                                Value="#FECACA"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ReviewDecision}"
                                                 Value="Inconclusive">
                                        <Setter TargetName="ReviewBadge"
                                                Property="Background"
                                                Value="#78350F"/>
