<UserControl x:Class="FORENXAI.Desktop.Views.XaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">

    <UserControl.Resources>

        <Style x:Key="XaiColumnHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#1E293B"/>

            <Setter Property="Foreground"
                    Value="#F8FAFC"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="BorderBrush"
                    Value="#334155"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

        </Style>


        <Style x:Key="XaiRowStyle"
               TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="#0F172A"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="BorderBrush"
                    Value="#1E293B"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Background"
                            Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="XaiCellStyle"
               TargetType="DataGridCell">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="8,6"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsMouseOver,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#2B5D87"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding IsSelected,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                             Value="True">

                    <Setter Property="Background"
                            Value="#60A5FA"/>

                    <Setter Property="Foreground"
                            Value="#0F172A"/>

                    <Setter Property="FontWeight"
                            Value="SemiBold"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Page header -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="XAI ANALYSIS"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Explainable AI analysis of detected network threats"
                       Foreground="#94A3B8"
                       FontSize="14"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- Case loader -->

        <Border Grid.Row="1"
                Background="#151F2F"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Case ID"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>


                <TextBox x:Name="CaseIdTextBox"
                         Grid.Column="1"
                         Height="36"
                         Padding="10,7"
                         Background="#0F172A"
                         Foreground="White"
                         BorderBrush="#334155"
                         BorderThickness="1"/>


                <Button Grid.Column="2"
                        Content="LOAD CASE"
                        Width="120"
                        Height="36"
                        Margin="12,0,0,0"
                        Click="LoadCase_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>


                <TextBlock x:Name="StatusText"
                           Grid.Column="3"
                           Text="No case loaded"
                           Foreground="#94A3B8"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

            </Grid>

        </Border>


        <!-- Main content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.55*"/>
            </Grid.ColumnDefinitions>


            <!-- Threat list -->

            <Border Grid.Column="0"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,12">

                        <TextBlock Text="DETECTED THREATS"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="ThreatCountText"
                                   Text="0 threat flows"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>

                        <!-- A capture can hold hundreds of detections.
                             Filtering by class or flow number is faster
                             than scrolling to find one. -->

                        <Border Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,10,0,0">

                            <Grid>

                                <!-- Watermark. Its visibility is set in
                                     code rather than bound through a
                                     converter, so there is no resource to
                                     resolve at runtime. -->

                                <TextBlock x:Name="ThreatFilterPlaceholder"
                                           Text="Filter by class or flow number"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <TextBox x:Name="ThreatFilterBox"
                                         Background="Transparent"
                                         Foreground="#E2E8F0"
                                         CaretBrush="#60A5FA"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Padding="10,7"
                                         TextChanged="ThreatFilterBox_TextChanged"/>

                            </Grid>

                        </Border>

                    </StackPanel>


                    <!-- One card per detection: the class it was given,
                         how confident the model was, and the feature that
                         drove it. Clicking a card loads its SHAP breakdown
                         and its recommendation on the right.

                         Virtualising means a capture with thousands of
                         detections scrolls as smoothly as one with ten. -->

                    <ListBox x:Name="ThreatList"
                             Grid.Row="1"
                             SelectionMode="Single"
                             SelectionChanged="ThreatList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border x:Name="CardRoot"
                                                    Background="#0F172A"
                                                    BorderBrush="#1E293B"
                                                    BorderThickness="1"
                                                    CornerRadius="8">

                                                <ContentPresenter/>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="CardRoot"
                                                            Property="Background"
                                                            Value="#152238"/>
                                                    <Setter TargetName="CardRoot"
                                                            Property="BorderBrush"
                                                            Value="#334155"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="CardRoot"
                                                            Property="Background"
                                                            Value="#17263D"/>
                                                    <Setter TargetName="CardRoot"
                                                            Property="BorderBrush"
                                                            Value="#60A5FA"/>
                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>


                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- Severity stripe. Colour is a second
                                         channel only; the class name carries
                                         the same information in words. -->

                                    <Border Grid.Column="0"
                                            Background="{Binding SeverityBrush}"
                                            CornerRadius="8,0,0,8"/>


                                    <StackPanel Grid.Column="1"
                                                Margin="12,10,12,10">

                                        <Grid>

                                            <TextBlock Text="{Binding PredictedClass}"
                                                       Foreground="#F1F5F9"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Left"/>

                                            <TextBlock Text="{Binding FlowLabel}"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                        </Grid>


                                        <!-- Confidence, as a bar and as a
                                             number. The bar is scanned; the
                                             number is quoted in a report. -->

                                        <Grid Margin="0,8,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Height="4"
                                                    Background="#1E293B"
                                                    CornerRadius="2"
                                                    VerticalAlignment="Center">

                                                <Border Background="{Binding SeverityBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding ConfidenceBarWidth}"/>

                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ConfidenceDisplay}"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>

                                        </Grid>


                                        <TextBlock Text="{Binding TopDriver}"
                                                   Foreground="#7C8BA1"
                                                   FontSize="11"
                                                   Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <TextBlock x:Name="ThreatEmptyText"
                               Grid.Row="1"
                               Text=""
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,24,0,0"/>

                </Grid>

            </Border>


            <!-- XAI / Recommendations / Review -->

            <Border Grid.Column="1"
                    Background="#151F2F"
                    CornerRadius="10"
                    Padding="18"
                    Margin="10,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Selected prediction -->

                        <Grid Grid.Row="0"
                              Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="WHY THIS DECISION"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="16"/>

                                <TextBlock x:Name="SelectedClassText"
                                           Text="Select a detected threat"
                                           Foreground="#60A5FA"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right">

                                <TextBlock Text="Confidence"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="SelectedConfidenceText"
                                           Text="--"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Grid>


                        <!-- SHAP explanation -->

                        <Border Grid.Row="1"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,15">

                            <TextBlock x:Name="ExplanationText"
                                       Text="Select a threat flow to view its SHAP explanation."
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="20"/>

                        </Border>




                        <!-- Local Qwen narration -->

                        <Border Grid.Row="2"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,15">

                            <StackPanel>

                                <Grid Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="GENAI EXPLANATION"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Grounded narration generated locally from XGBoost and TreeSHAP evidence"
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <TextBlock x:Name="GenAiStatusText"
                                               Grid.Column="1"
                                               Text="Not generated"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0"/>

                                </Grid>

                                <Border Background="#111827"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">

                                    <TextBlock x:Name="GenAiExplanationText"
                                               Text="Select a detected threat to generate a local AI explanation."
                                               Foreground="#CBD5E1"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>

                                </Border>

                            </StackPanel>

                        </Border>


                        <!-- SHAP contributors -->

                        <Grid Grid.Row="3">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="180"/>
                            </Grid.RowDefinitions>


                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,10">

                                <TextBlock Text="TOP SHAP CONTRIBUTORS"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="16"/>

                                <TextBlock Text="Most influential features for the selected prediction"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <DataGrid x:Name="ShapDataGrid"
                                      Grid.Row="1"
                                      MaxHeight="320"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      Background="#0F172A"
                                      Foreground="#E2E8F0"
                                      BorderBrush="#334155"
                                      BorderThickness="1"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#1E293B"
                                      VerticalGridLinesBrush="#1E293B"
                                      RowBackground="#0F172A"
                                      AlternatingRowBackground="#111827"
                                      AlternationCount="2"
                                      HeadersVisibility="Column"
                                      RowStyle="{StaticResource XaiRowStyle}"
                                      CellStyle="{StaticResource XaiCellStyle}"
                                      ColumnHeaderStyle="{StaticResource XaiColumnHeaderStyle}">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding Rank}"
                                                        Width="45"/>

                                    <DataGridTextColumn Header="Feature"
                                                        Binding="{Binding Feature}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Observed Value"
                                                        Binding="{Binding RawValue}"
                                                        Width="125"/>

                                    <DataGridTextColumn Header="SHAP Value"
                                                        Binding="{Binding ShapValue}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Direction"
                                                        Binding="{Binding DirectionDisplay}"
                                                        Width="150"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>


                        <!-- Recommended actions -->

                        <Border Grid.Row="5"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,15,0,0">

                            <StackPanel>

                                <StackPanel Margin="0,0,0,12">

                                    <TextBlock Text="RECOMMENDED ACTIONS"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Investigator guidance for the selected threat classification"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               Margin="0,4,0,0"/>

                                </StackPanel>


                                <Border Background="#111827"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12">

                                    <TextBlock x:Name="RecommendationSummaryText"
                                               Text="Select a detected threat to view recommended actions."
                                               Foreground="#CBD5E1"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>

                                </Border>


                                <ItemsControl x:Name="RecommendationActionsList">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Grid Margin="0,4">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <Border Grid.Column="0"
                                                        Width="7"
                                                        Height="7"
                                                        CornerRadius="4"
                                                        Background="#60A5FA"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="4,7,0,0"/>


                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           Foreground="#E2E8F0"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19"/>

                                            </Grid>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>


                                <!-- Provenance. Every action above was
                                     traced back to one retrieved passage
                                     before the backend returned it. -->

                                <Border Background="#0B1220"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,14,0,0">

                                    <StackPanel>

                                        <TextBlock x:Name="RecommendationVerificationText"
                                                   Text=""
                                                   Foreground="#7DD3A8"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock x:Name="RecommendationSourcesText"
                                                   Text=""
                                                   Foreground="#94A3B8"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>


                        <!-- Investigator review -->

                        <Border Grid.Row="4"
                                Background="#0F172A"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,15,0,0">

                            <StackPanel>

                                <TextBlock Text="INVESTIGATOR REVIEW"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Record the investigator's assessment of the selected threat flow."
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Margin="0,4,0,14"/>


                                <TextBlock Text="Decision"
                                           Foreground="#CBD5E1"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">

                                    <RadioButton x:Name="ConfirmedRadioButton"
                                                 Content="Confirmed"
                                                 GroupName="InvestigatorDecision"
                                                 Foreground="#E2E8F0"
                                                 Margin="0,0,18,0"
                                                 VerticalAlignment="Center"/>

                                    <RadioButton x:Name="RejectedRadioButton"
                                                 Content="Rejected"
                                                 GroupName="InvestigatorDecision"
                                                 Foreground="#E2E8F0"
                                                 Margin="0,0,18,0"
                                                 VerticalAlignment="Center"/>

                                    <RadioButton x:Name="InconclusiveRadioButton"
                                                 Content="Inconclusive"
                                                 GroupName="InvestigatorDecision"
                                                 Foreground="#E2E8F0"
                                                 IsChecked="True"
                                                 VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Text="Investigator Notes"
                                           Foreground="#CBD5E1"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>


                                <TextBox x:Name="InvestigatorNotesTextBox"
                                         Height="90"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#111827"
                                         Foreground="#E2E8F0"
                                         BorderBrush="#334155"
                                         BorderThickness="1"
                                         Padding="10"
                                         Margin="0,0,0,14"/>


                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock x:Name="ReviewStatusText"
                                               Grid.Column="0"
                                               Text="No review saved for the selected flow."
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>


                                    <Button x:Name="SaveReviewButton"
                                            Grid.Column="1"
                                            Content="SAVE REVIEW"
                                            Width="130"
                                            Height="36"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="SaveReviewButton_Click"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </Grid>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>